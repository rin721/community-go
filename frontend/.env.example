# Admin Surface 构建期配置示例（复制为 frontend/.env 后按需修改；.env 不入库）。
#
# 用法：
#   cp .env.example .env        # 然后按需设置
#   pnpm codegen:admin          # codegen/watch/build 会读取 frontend/.env
#
# 全部键均为可选；缺省 = 默认静态（与历史行为一致）。

# ---- Plugin 动态路由支持（默认静态）----
# false / 缺省  ：默认静态。Plugin routes/ 中出现 [id] 等动态段会被 codegen
#                 Host capability gate 硬失败（UNSUPPORTED_DYNAMIC_PLUGIN_ROUTE）。
# true          ：启用动态路由。允许 Plugin 使用 routes/[id]/page.tsx 等动态段，
#                 但 output:"export" 下动态 page 必须自带 generateStaticParams
#                 （构建期枚举），否则报 DYNAMIC_ROUTE_REQUIRES_GENERATE_STATIC_PARAMS。
ADMIN_SURFACE_DYNAMIC_ROUTES=false
