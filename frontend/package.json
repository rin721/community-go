{
  "name": "community-go-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node tooling/admin-codegen/dev.mjs",
    "build": "pnpm codegen:admin && pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:browser": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node tooling/check-boundaries-fixtures.mjs && node tooling/check-boundaries.mjs",
    "foundation:check": "node tooling/check-foundation-fixtures.mjs && node tooling/check-foundation-governance.mjs",
    "dependency:check": "node tooling/check-dependencies.mjs",
    "performance:check": "node tooling/check-performance-budget.mjs",
    "codegen:admin": "node tooling/admin-codegen/codegen.mjs",
    "codegen:admin:check": "node tooling/admin-codegen/codegen.mjs --check",
    "codegen:admin:watch": "node tooling/admin-codegen/watch.mjs",
    "docs:check": "node tooling/check-docs.mjs",
    "check": "pnpm foundation:check && pnpm architecture:check && pnpm dependency:check && pnpm codegen:admin:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm performance:check && pnpm test:browser && pnpm format:check && pnpm docs:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
