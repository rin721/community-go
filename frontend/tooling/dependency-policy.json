{
  "dependencies": {
    "@community-go/core": { "owner": "workspace", "allowed": ["apps/web"] },
    "@community-go/design-system": { "owner": "workspace", "allowed": ["apps/web"] },
    "@community-go/reference": {
      "owner": "reference feature",
      "allowed": ["apps/web", "apps/desktop"]
    },
    "@community-go/schemas": {
      "owner": "runtime validation",
      "allowed": ["apps/web", "packages/reference"]
    },
    "@community-go/types": {
      "owner": "stable shared types",
      "allowed": [
        "apps/web",
        "apps/desktop",
        "packages/core",
        "packages/schemas",
        "packages/ui-adapter"
      ]
    },
    "@community-go/ui-adapter": { "owner": "UI contract", "allowed": ["apps/web"] },
    "@heroui/react": {
      "owner": "accessible UI primitives",
      "allowed": ["packages/ui-adapter"],
      "category": "ui-primitives"
    },
    "@heroui/styles": { "owner": "HeroUI vendor styles", "allowed": ["packages/ui-adapter"] },
    "@hookform/resolvers": { "owner": "form-schema bridge", "allowed": ["apps/web"] },
    "i18next": {
      "owner": "localization runtime",
      "allowed": ["apps/web"],
      "category": "localization"
    },
    "lucide-react": { "owner": "interface icons", "allowed": ["apps/web"], "category": "icons" },
    "next": {
      "owner": "Web Host framework and routing",
      "allowed": ["apps/web"],
      "category": "framework"
    },
    "react": { "owner": "view runtime", "allowed": ["apps/web", "packages/ui-adapter"] },
    "react-dom": { "owner": "Web renderer", "allowed": ["apps/web"] },
    "react-hook-form": {
      "owner": "complex form state",
      "allowed": ["apps/web"],
      "category": "form-state"
    },
    "react-i18next": { "owner": "React localization binding", "allowed": ["apps/web"] },
    "zod": { "owner": "schema validation", "allowed": ["packages/schemas"], "category": "schema" },
    "zustand": {
      "owner": "cross-feature client state",
      "allowed": ["apps/web"],
      "category": "client-state"
    }
  }
}
