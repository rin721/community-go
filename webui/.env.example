# WebUI 开发服务配置；复制为 .env.local 后按本机端口或代理调整。
WEBUI_DEV_HOST=127.0.0.1
WEBUI_DEV_PORT=5173
WEBUI_API_TARGET=http://127.0.0.1:8080
WEBUI_MANAGEMENT_TARGET=http://127.0.0.1:9090

# WebUI 数据源环境显式声明，取值：
#   server-hosted  默认：Go 服务托管构建产物（模式 B，/management 同源 facade）；
#   separated      前后端分离（模式 A，Vite 代理 /management 到 9090，开发声明用）；
#   mock           无真实数据响应环境（静态预览/演示，整个 WebUI 使用本地 mock 数据）。
# 托管构建（webui build）会拒绝 mock 声明；mock 演示构建请使用普通 pnpm build + 本环境变量。
VITE_WEBUI_DATA_SOURCE=server-hosted
